generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum VerificationStatus {
  UNVERIFIED
  DATA_PROVIDED
  VERIFIED
}

enum LoanStatus {
  DRAFT
  WAITING_LENDER_SIGNATURE
  WAITING_BORROWER_SIGNATURE
  SIGNED
  WAITING_TRANSFER
  WAITING_TRANSFER_CONFIRMATION
  ACTIVE
  PARTIALLY_REPAID
  OVERDUE
  REPAID
  CLOSED
  CANCELLED
  DISPUTED
}

enum LoanInterestType {
  INTEREST_FREE
}

model User {
  id        String     @id @default(uuid()) @db.Uuid
  phone     String     @unique
  email     String?    @unique
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  identity Identity?
  sessions UserSession[]
  loansAsLender Loan[] @relation("LoanLender")
  loansAsBorrower Loan[] @relation("LoanBorrower")

  @@map("users")
}

model Identity {
  id                      String             @id @default(uuid()) @db.Uuid
  userId                  String             @unique @map("user_id") @db.Uuid
  iinEncrypted            String?            @map("iin_encrypted")
  iinHash                 String?            @unique @map("iin_hash")
  firstName               String?            @map("first_name")
  lastName                String?            @map("last_name")
  middleName              String?            @map("middle_name")
  birthDate               DateTime?          @map("birth_date") @db.Date
  documentNumberEncrypted String?            @map("document_number_encrypted")
  verificationStatus      VerificationStatus @default(UNVERIFIED) @map("verification_status")
  verifiedAt              DateTime?          @map("verified_at")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("identities")
}

model UserSession {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash")
  device           String?
  ip               String?
  userAgent        String?  @map("user_agent")
  createdAt        DateTime @default(now()) @map("created_at")
  lastActivityAt   DateTime @default(now()) @map("last_activity_at")
  expiresAt        DateTime @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model SystemMetadata {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_metadata")
}


model Loan {
  id             String     @id @default(uuid()) @db.Uuid
  number         String     @unique
  lenderId       String     @map("lender_id") @db.Uuid
  borrowerId     String?    @map("borrower_id") @db.Uuid
  borrowerPhone  String     @map("borrower_phone")
  principalAmount Decimal   @map("principal_amount") @db.Decimal(18, 2)
  remainingAmount Decimal   @map("remaining_amount") @db.Decimal(18, 2)
  currency       String     @default("KZT") @db.VarChar(3)
  issuedAt       DateTime?  @map("issued_at") @db.Date
  dueDate        DateTime   @map("due_date") @db.Date
  status         LoanStatus @default(DRAFT)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  closedAt       DateTime?  @map("closed_at")

  lender   User  @relation("LoanLender", fields: [lenderId], references: [id], onDelete: Restrict)
  borrower User? @relation("LoanBorrower", fields: [borrowerId], references: [id], onDelete: SetNull)
  terms    LoanTerms?

  @@index([lenderId, status])
  @@index([borrowerId, status])
  @@index([borrowerPhone])
  @@map("loans")
}

model LoanTerms {
  id           String           @id @default(uuid()) @db.Uuid
  loanId       String           @unique @map("loan_id") @db.Uuid
  interestType LoanInterestType @default(INTEREST_FREE) @map("interest_type")
  purpose      String?
  comment      String?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@map("loan_terms")
}

model LoanSequence {
  year  Int @id
  value Int

  @@map("loan_sequences")
}
