# Shared local defaults
NODE_ENV=development

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# API
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://dolg:dolg_dev_password@localhost:5432/dolg?schema=public
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
OTP_TTL_SECONDS=300
FIELD_ENCRYPTION_KEY=change-me-32-byte-secret

# Object storage (MinIO locally, S3-compatible in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=dolg
S3_SECRET_KEY=dolg_minio_password
S3_BUCKET=dolg-documents
S3_FORCE_PATH_STYLE=true

# Future integrations
SIGEX_BASE_URL=
SIGEX_API_KEY=
SMS_PROVIDER_API_KEY=
